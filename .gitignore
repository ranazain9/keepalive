# ==========================================
# KeepAlive Project .gitignore
# ==========================================

# Environment variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env
secrets.json
api_keys.json

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Audio & Video Recordings & Temporary Media Dumps (Large files)
*.wav
*.mp3
*.m4a
*.pcm
*.ogg
*.webm
*.raw
*.mp4
!client/public/videos/*.mp4
*.mkv
recordings/
temp_audio/
scratch/

# Unit Tests & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# IDEs, Editors & AI Agent Artifacts
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.gemini/

# Internal Brainstorming, Draft Documents & Review Prompts (Keep private)
*.docx
*.doc
~$*.docx
~$*.doc
*.tmp
generate_docs.py
EXTERNAL_REVIEW_PROMPT.md
docs_drafts/
review_notes/
lawfiles/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Databases
*.log
logs/
*.sqlite
*.sqlite3
*.db
